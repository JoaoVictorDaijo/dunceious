{
  "name": "genedunceious",
  "private": true,
  "version": "4.0.1",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.7.0+sha512.19cc852c120c7125760f2443ee6be0ca5b40f9f50598de1a09a1f177503e010e57c23c77646e01e761de59bf874fb22a3398c33ab9691fc13eb946b6f0f4d620",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.4",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 60",
    "lint:headers": "node scripts/check-license-headers.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "node bench/runBench.mjs",
    "plot": "node bench/visualize.mjs",
    "perf": "node --expose-gc node_modules/vitest/vitest.mjs run --config perf/vitest.config.ts",
    "version:patch": "pnpm version patch --no-git-tag-version --no-git-checks",
    "version:minor": "pnpm version minor --no-git-tag-version --no-git-checks",
    "version:major": "pnpm version major --no-git-tag-version --no-git-checks",
    "test:e2e": "pnpm build && pnpm test:e2e:run",
    "test:e2e:run": "playwright test",
    "changelog:release": "node scripts/changelog-release.mjs",
    "standards:fetch": "node scripts/fetch-standards.mjs",
    "standards:verify-vocab": "node scripts/gen-feature-table.mjs --check",
    "standards:genetic-codes": "node scripts/gen-genetic-codes.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fortawesome/fontawesome-free": "6.7.2",
    "@types/react-window": "^1.8.8",
    "d3": "^7.9.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-window": "^1.8.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.13.0",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.30",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
